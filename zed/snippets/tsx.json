{
  "rnstyle": {
    "description": "Creates a react native stylesheet - not a hook. Use rnstylehook for that",
    "prefix": "rnstyle",
    "body": [
      "import { StyleSheet } from 'react-native';",
      "",
      "export const styles = StyleSheet.create({",
      "  container: {",
      "    $0",
      "  },",
      "});"
    ]
  },
  "rnstylehook": {
    "description": "Creates a react native stylesheet hook",
    "prefix": "rnstylehook",
    "body": [
      "import { StyleSheet } from 'react-native';",
      "import { useResponsive } from 'react-native-responsive-hook';",
      "",
      "import { isLargeDevice } from '@theme/breakpoints';",
      "",
      "export const useStyles = () => {",
      "  const styles = StyleSheet.create({",
      "    container: {",
      "     width: isLargeDevice(breakPointGroup) ? '30%' : '50%'",
      "     $0",
      "    }",
      "  })",
      "  return { styles }",
      "}"
    ]
  },
  "reactFn": {
    "description": "Creates a react functional component",
    "prefix": "reactFn",
    "body": [
      "import React from 'react'",
      "",
      "export const $1 = ({} : {}) => {",
      "  return (",
      "    <>$0</>",
      "  );",
      "}"
    ]
  },
  "mswError": {
    "description": "Mock an error - cursor placed at URL starting point",
    "prefix": "mswError",
    "body": [
      "server.use(",
      " http.get(",
      "   'https://example.com/hello$1',",
      "   () => {",
      "     return HttpResponse.json(",
      "       { message: \"Internal server error\" },",
      "       { status: 500 }",
      "     );",
      "   },",
      " )",
      ");"
    ]
  },
  "mswDelay": {
    "description": "Mock a never resolving response - cursor placed at URL starting point",
    "prefix": "mswDelay",
    "body": [
      "server.use(",
      " http.get(",
      "   'https://example.com/hello$1',",
      "   async () => {",
      "     await delay('infinite');",
      "     return HttpResponse.json(",
      "       { message: \"Internal server error\" },",
      "       { status: 500 }",
      "     );",
      "   },",
      " )",
      ");"
    ]
  },
  "mswSuccess": {
    "description": "Mock a response - cursor placed at URL starting point",
    "prefix": "mswSuccess",
    "body": [
      "server.use(",
      " http.get(",
      "   'https://example.com/hello$1',",
      "   () => {",
      "     return HttpResponse.json($2);",
      "   },",
      " )",
      ");"
    ]
  },
  "mockReact": {
    "description": "Mocks a react component and places a div with its name",
    "prefix": "mockReact",
    "body": ["jest.mock('$1', () => () => {", "  return <div>$2</div>;", "});$0"]
  },
  "mockHook": {
    "description": "Mocks a hook and its return value after being called",
    "prefix": "mockHook",
    "body": ["jest.mock('$1', () => () => ({", " $2: $3,", "}));"]
  },
  "mockFn": {
    "description": "Mock an exported function from a module",
    "prefix": "mockFn",
    "body": ["jest.mock('$1', () => ({", "  $2: jest.fn(),", "}));", "$0"]
  },
  "itEach": {
    "description": "Create a it.each block",
    "prefix": "itEach",
    "body": [
      "it.each([",
      " [$1, $2],",
      " [$1, $2],",
      "])(\"input %s equals %s expected\", $3 (input, expected) => {",
      " $0",
      " expect(input).toBe(expected);",
      "});"
    ]
  },
  "expectThrow": {
    "description": "Expect a function to throw",
    "prefix": "expectThrow",
    "body": ["expect(() => ", "  $1", ").toThrow($1)"]
  }
}
